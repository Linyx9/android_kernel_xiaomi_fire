load("//build/bazel_mgk_rules:mgk_ko.bzl", "define_mgk_ko")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

exports_files([
    "Kconfig",
])

filegroup(
    name = "sources",
    srcs = glob([
        "**",
    ], exclude = [
        "BUILD.bazel",
    ]),
)

define_mgk_ko(
    name = "system_heap",
    outs = [
        "mtk_heap_debug.ko",
        "mtk_heap_refill.ko",
        "mtk_sec_heap.ko",
        "system_heap.ko",
    ],
)
